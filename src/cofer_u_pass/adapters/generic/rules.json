    {
      "kind": "css",
      "value": "[data-cofer-response]"
    }
  ],
  "generation_active": [
    {
      "kind": "css",
      "value": "[data-cofer-generating='true']"
    }
  ],
  "attachment_input": [
    {
      "kind": "css",
      "value": "input[type='file'][data-cofer-attachment]"
