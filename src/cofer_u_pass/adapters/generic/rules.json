    {
      "kind": "css",
      "value": "[data-cofer-message-input]"
    }
  ],
  "send_button": [
    {
      "kind": "css",
      "value": "[data-cofer-send]"
    }
  ],
  "user_message": [
    {
      "kind": "css",
      "value": "[data-cofer-user-message]"
    }
  ],
