{
  "schema_version": "1.0",
  "provider": "deepseek",
  "version": "1.0.1",
  "home_url": "https://chat.deepseek.com/",
  "allowed_origins": [
    "https://chat.deepseek.com"
  ],
  "auth_origins": [
    "https://chat.deepseek.com"
  ],
  "capabilities": [
    "conversation.new",
    "conversation.continue",
    "conversation.import",
    "message.send",
    "response.stream",
    "attachment.upload",
    "artifact.download"
  ],
  "authenticated": [
    {
      "kind": "css",
      "value": "textarea"
    },
    {
      "kind": "css",
      "value": "div[contenteditable='true']"
    }
  ],
  "message_input": [
    {
      "kind": "css",
      "value": "textarea"
    },
    {
      "kind": "css",
      "value": "div[contenteditable='true'][role='textbox']"
    }
  ],
  "send_button": [
    {
      "kind": "css",
      "value": "button[aria-label*='Send']"
    },
    {
      "kind": "css",
      "value": "div[role='button'][aria-label*='Send']"
    }
  ],
  "user_message": [
    {
      "kind": "css",
      "value": "div[class*='message'][class*='user']"
    }
  ],
  "response": [
    {
      "kind": "css",
      "value": "div[class*='ds-markdown']"
    },
    {
      "kind": "css",
      "value": "div[class*='message'][class*='assistant']"
    }
  ],
  "generation_active": [
    {
      "kind": "css",
      "value": "button[aria-label*='Stop']"
    },
    {
      "kind": "css",
      "value": "div[role='button'][aria-label*='Stop']"
    }
  ],
  "attachment_input": [
    {
      "kind": "css",
      "value": "input[type='file']"
    }
  ],
  "attachment_button": [
    {
      "kind": "css",
      "value": "button[aria-label*='Upload'], button[aria-label*='file']"
    }
  ],
  "attachment_ready": [
    {
      "kind": "css",
      "value": "div[class*='attachment'], div[class*='file']"
    }
  ],
  "artifact": [
    {
      "kind": "css",
      "value": "div[class*='assistant'] a[download], div[class*='assistant'] a[href]"
    }
  ]
}
